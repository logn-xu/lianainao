/* 情侣信息 */
.hero {
  position: relative;
  padding: 34rpx 32rpx 28rpx;
  border-radius: 32rpx;
  background: linear-gradient(140deg, #FFE9DF 0%, #FDE3EA 52%, #F3E8FA 100%);
  box-shadow: 0 14rpx 36rpx rgba(206, 158, 148, 0.16);
  overflow: hidden;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.couple {
  display: flex;
  align-items: center;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  box-shadow: 0 4rpx 14rpx rgba(180, 140, 130, 0.16);
}

.avatar.ta {
  background: rgba(255, 255, 255, 0.9);
}

.heart {
  margin: 0 10rpx;
  font-size: 26rpx;
  color: #E0868F;
}

.day-badge {
  display: flex;
  align-items: baseline;
  color: #B4666F;
}

.day-num {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.day-unit {
  margin-left: 6rpx;
  font-size: 22rpx;
  opacity: 0.75;
}

.hero-names {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #4A3B33;
  letter-spacing: 1rpx;
}

.hero-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #9C7F78;
}

.hero-stats {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.75);
}

.hero-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hs-num {
  font-size: 34rpx;
  font-weight: 600;
  color: #6B5249;
}

.hs-label {
  margin-top: 2rpx;
  font-size: 21rpx;
  color: #A98C85;
}

.hero-divider {
  width: 1rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.85);
}

/* 快速记录 */
.quick {
  margin-top: 24rpx;
  padding: 26rpx 20rpx 22rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 34rpx rgba(150, 116, 96, 0.07);
}

.quick-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10rpx 18rpx;
}

.quick-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3C332C;
}

.quick-tip {
  font-size: 21rpx;
  color: #C2B4A6;
}

.quick-row {
  display: flex;
  justify-content: space-between;
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0 6rpx;
  border-radius: 20rpx;
}

.quick-hover {
  background: #FBF6F0;
}

.quick-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.quick-name {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8B7F74;
}

/* 时间线 */
.group {
  margin-top: 30rpx;
}

.group-head {
  display: flex;
  align-items: center;
  padding: 0 8rpx 14rpx;
}

.group-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #5B4C42;
}

.group-week {
  margin-left: 10rpx;
  font-size: 21rpx;
  color: #B4A597;
}

.group-line {
  flex: 1;
  height: 1rpx;
  margin: 0 16rpx;
  background: #EADFD3;
}

.group-count {
  font-size: 21rpx;
  color: #B4A597;
}

.group-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 6rpx 28rpx;
  box-shadow: 0 10rpx 34rpx rgba(150, 116, 96, 0.07);
}

.rec {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5EEE6;
}

.rec:last-child {
  border-bottom: none;
}

.rec-hover {
  background: #FCF8F3;
}

.rec-icon {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}

.rec-body {
  flex: 1;
  margin-left: 20rpx;
  padding-top: 2rpx;
}

.rec-line {
  display: flex;
  align-items: baseline;
}

.rec-name {
  font-size: 28rpx;
  font-weight: 600;
}

.rec-amount {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: #9C8E80;
}

.rec-time {
  margin-left: auto;
  font-size: 21rpx;
  color: #BBAEA1;
}

.rec-note {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #8B7F74;
  word-break: break-all;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 56rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F4AEAE 0%, #E0868F 100%);
  color: #FFFFFF;
  font-size: 54rpx;
  font-weight: 300;
  line-height: 96rpx;
  text-align: center;
  box-shadow: 0 16rpx 32rpx rgba(224, 134, 143, 0.4);
  z-index: 90;
}

.fab-hover {
  transform: scale(0.94);
  opacity: 0.92;
}
