.month-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0 24rpx;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFFFFF;
  color: #A2937F;
  font-size: 36rpx;
  line-height: 58rpx;
  text-align: center;
  box-shadow: 0 6rpx 18rpx rgba(150, 116, 96, 0.08);
}

.nav-btn.disabled {
  opacity: 0.35;
}

.nav-hover {
  background: #FBF1E7;
}

.month-title {
  min-width: 240rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #4A3E35;
}

.summary {
  display: flex;
}

.sum-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0 24rpx;
  border-radius: 26rpx;
  margin-right: 18rpx;
}

.sum-card:last-child {
  margin-right: 0;
}

.sum-card.milk {
  background: #F8EBDC;
}

.sum-card.snack {
  background: #FBE8DE;
}

.sum-card.sport {
  background: #E3F1EA;
}

.sum-num {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.1;
}

.sum-card.milk .sum-num {
  color: #B98253;
}

.sum-card.snack .sum-num {
  color: #D2794E;
}

.sum-card.sport .sum-num {
  color: #4E9D80;
}

.sum-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #8B7F74;
}

.card {
  margin-top: 24rpx;
}

/* 日历 */
.week-head {
  display: flex;
  margin-top: 24rpx;
}

.week-cell {
  width: 14.2857%;
  text-align: center;
  font-size: 20rpx;
  color: #BBAEA1;
}

.calendar {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.cal-cell {
  width: 14.2857%;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-inner {
  position: relative;
  width: 62rpx;
  height: 62rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  color: #A2937F;
  background: transparent;
}

.cal-inner.lv1 {
  background: #FCEFEF;
  color: #C4808A;
}

.cal-inner.lv2 {
  background: #F9D9DA;
  color: #A95D68;
}

.cal-inner.lv3 {
  background: #EFA6A6;
  color: #FFFFFF;
}

.cal-inner.is-today {
  box-shadow: inset 0 0 0 2rpx #E0868F;
}

.cal-inner.has-period::after {
  content: '';
  position: absolute;
  bottom: 6rpx;
  left: 50%;
  width: 8rpx;
  height: 8rpx;
  margin-left: -4rpx;
  border-radius: 50%;
  background: #E0557A;
}

.cal-inner.lv3.has-period::after {
  background: #FFFFFF;
}

.legend {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F5EEE6;
}

.legend-text {
  font-size: 20rpx;
  color: #BBAEA1;
  margin: 0 8rpx;
}

.legend-spacer {
  flex: 1;
}

.lg {
  width: 22rpx;
  height: 22rpx;
  border-radius: 7rpx;
  margin-right: 6rpx;
}

.lg.lv0 {
  background: #F6EFE7;
}

.lg.lv1 {
  background: #FCEFEF;
}

.lg.lv2 {
  background: #F9D9DA;
}

.lg.lv3 {
  background: #EFA6A6;
}

.period-mark {
  border-radius: 50%;
  background: #E0557A;
  width: 14rpx;
  height: 14rpx;
}

/* 姨妈 */
.rows {
  margin-top: 20rpx;
}

.stat-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F7F0E8;
}

.sr-label {
  font-size: 25rpx;
  color: #8B7F74;
}

.sr-value {
  font-size: 26rpx;
  color: #4A3E35;
}

.sr-value.accent {
  color: #D9535C;
  font-weight: 600;
}

.history {
  margin-top: 20rpx;
}

.history-label {
  font-size: 21rpx;
  color: #BBAEA1;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.h-chip {
  padding: 8rpx 18rpx;
  margin: 0 10rpx 10rpx 0;
  border-radius: 999rpx;
  background: #FCE7EC;
  color: #C4707F;
  font-size: 22rpx;
}

.footnote {
  margin-top: 20rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #BBAEA1;
}

/* 连续记录 */
.streak-card {
  display: flex;
  align-items: center;
  padding: 34rpx 0;
}

.streak-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.streak-num {
  font-size: 46rpx;
  font-weight: 700;
  color: #B98253;
  line-height: 1.1;
}

.streak-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #8B7F74;
}

.streak-div {
  width: 1rpx;
  height: 56rpx;
  background: #F1E7DB;
}
