<view class="stats">
  <view class="panel overview">
    <view class="overview-head">
      <text class="panel-title">月度概览</text>
      <view class="month-bar">
        <view class="nav-btn" hover-class="nav-hover" bindtap="prevMonth">‹</view>
        <text class="month-title">{{monthLabel}}</text>
        <view class="nav-btn {{canNext ? '' : 'disabled'}}" bindtap="nextMonth">›</view>
      </view>
    </view>

    <view class="metrics">
      <view class="metric milk">
        <text class="metric-num">{{summary.milktea}}</text>
        <text class="metric-label">杯奶茶</text>
      </view>
      <view class="metric snack">
        <text class="metric-num">{{summary.snack}}</text>
        <text class="metric-label">次放纵</text>
      </view>
      <view class="metric sport">
        <text class="metric-num">{{summary.sport}}</text>
        <text class="metric-label">次运动</text>
      </view>
      <view class="metric total">
        <text class="metric-num">{{summary.total}}</text>
        <text class="metric-label">条记录</text>
      </view>
    </view>

    <view class="streak-line">
      <text>连续记录 <text class="streak-num">{{streak.current}}</text> 天</text>
      <text class="streak-dot">·</text>
      <text>最长 <text class="streak-num">{{streak.longest}}</text> 天</text>
    </view>
  </view>

  <view class="panel">
    <text class="panel-title">记录日历</text>
    <text class="panel-sub">颜色越深，那天记下的小事越多</text>
    <view class="week-head">
      <text class="week-cell" wx:for="{{weekHead}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="calendar">
      <view class="cal-cell" wx:for="{{cells}}" wx:key="key">
        <view class="cal-inner lv{{item.level}} {{item.today ? 'is-today' : ''}} {{item.period ? 'has-period' : ''}}">{{item.day || ''}}</view>
      </view>
    </view>
    <view class="legend">
      <text class="legend-text">少</text>
      <view class="lg lv0"></view>
      <view class="lg lv1"></view>
      <view class="lg lv2"></view>
      <view class="lg lv3"></view>
      <text class="legend-text">多</text>
      <view class="legend-spacer"></view>
      <view class="lg period-mark"></view>
      <text class="legend-text">姨妈日</text>
    </view>
  </view>

  <view class="panel">
    <text class="panel-title">姨妈小日历</text>
    <block wx:if="{{periodView}}">
      <view class="rows">
        <view class="stat-row">
          <text class="sr-label">上次开始</text>
          <text class="sr-value">{{periodView.lastText}} · {{periodView.sinceText}}</text>
        </view>
        <view class="stat-row">
          <text class="sr-label">平均周期</text>
          <text class="sr-value">{{periodView.cycle}} 天</text>
        </view>
        <view class="stat-row">
          <text class="sr-label">预计下次</text>
          <text class="sr-value accent">{{periodView.nextText}} · {{periodView.untilText}}</text>
        </view>
      </view>
      <view class="history">
        <text class="history-label">最近记录</text>
        <view class="history-list">
          <text class="h-chip" wx:for="{{periodView.history}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
      <view class="footnote">预测仅供参考，提前准备好热水和甜的东西。</view>
    </block>
    <view class="footnote" wx:else>还没有记录过，切到「时光记录」点「姨妈」记一笔吧。</view>
  </view>
</view>
