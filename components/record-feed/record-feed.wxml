<view class="feed">
  <view class="panel quick">
    <view class="quick-head">
      <text class="panel-title">快速记一笔</text>
      <text class="quick-tip">点击记录可编辑 · 长按删除</text>
    </view>
    <view class="quick-row">
      <view
        class="quick-item"
        wx:for="{{types}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onQuickAdd"
        hover-class="quick-hover"
      >
        <view class="quick-icon" style="background:{{item.bg}}">{{item.emoji}}</view>
        <text class="quick-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <block wx:if="{{!empty}}">
    <view class="group" wx:for="{{groups}}" wx:key="date" wx:for-item="group">
      <view class="group-head">
        <text class="group-label">{{group.label}}</text>
        <text class="group-week">{{group.weekday}}</text>
        <view class="group-line"></view>
        <text class="group-count">{{group.records.length}} 条</text>
      </view>

      <view class="panel group-card">
        <view
          class="rec"
          wx:for="{{group.records}}"
          wx:key="id"
          wx:for-item="rec"
          data-id="{{rec.id}}"
          bindtap="onRecordTap"
          bindlongpress="onRecordLongPress"
          hover-class="rec-hover"
        >
          <view class="rec-icon" style="background:{{rec.meta.bg}}">{{rec.meta.emoji}}</view>
          <view class="rec-body">
            <view class="rec-line">
              <text class="rec-name" style="color:{{rec.meta.color}}">{{rec.meta.fullName}}</text>
              <text class="rec-amount" wx:if="{{rec.meta.count}}">× {{rec.amount}}</text>
              <text class="rec-time">{{rec.authorEmoji}} {{rec.time}}</text>
            </view>
            <text class="rec-note" wx:if="{{rec.note}}">{{rec.note}}</text>
            <view class="rec-imgs" wx:if="{{rec.images.length}}">
              <image
                class="rec-img"
                wx:for="{{rec.images}}"
                wx:key="*this"
                src="{{item}}"
                mode="aspectFill"
                data-images="{{rec.images}}"
                data-current="{{item}}"
                catchtap="onPreviewImage"
              />
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view class="panel empty" wx:else>
    <text class="empty-emoji">🧋</text>
    <text class="empty-title">还没有记录</text>
    <text class="empty-sub">点上面的图标或右下角按钮，记下第一件小事</text>
  </view>
</view>
