<view class="page">
  <view class="hero">
    <view class="hero-top">
      <view class="couple">
        <view class="avatar me">{{profile.me.emoji}}</view>
        <view class="heart">♥</view>
        <view class="avatar ta">{{profile.ta.emoji}}</view>
      </view>
      <view class="day-badge" wx:if="{{days}}">
        <text class="day-label">在一起</text>
        <view class="day-value">
          <text class="day-num">{{days}}</text>
          <text class="day-unit">天</text>
        </view>
      </view>
    </view>
    <view class="hero-names">{{profile.me.name}} & {{profile.ta.name}}</view>
    <view class="hero-sub">{{heroSub}}</view>
  </view>

  <view class="view-switch">
    <view
      class="switch-item {{tab === item.key ? 'on' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onSwitchTab"
    >{{item.label}}</view>
  </view>

  <view class="tab-panel" hidden="{{tab !== 'feed'}}">
    <record-feed
      records="{{records}}"
      profile="{{profile}}"
      bind:add="onFeedAdd"
      bind:edit="onFeedEdit"
      bind:preview="onFeedPreview"
      bind:remove="onFeedRemove"
    />
  </view>

  <view class="tab-panel" hidden="{{tab !== 'stats'}}">
    <stats-panel records="{{records}}" profile="{{profile}}" />
  </view>

  <view class="fab" hover-class="fab-hover" bindtap="onFabTap">+</view>

  <composer
    show="{{composerShow}}"
    default-type="{{composerType}}"
    edit-record="{{editingRecord}}"
    bind:submit="onComposerSubmit"
    bind:edit="onComposerEdit"
    bind:close="onComposerClose"
  />
</view>
