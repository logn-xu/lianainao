/**app.wxss**/
page {
  --bg: #FBF5ED;
  --card: #FFFFFF;
  --ink: #3C332C;
  --ink-2: #8B7F74;
  --ink-3: #BBAEA1;
  --line: #F2E9DF;
  --rose: #E0868F;
  --rose-soft: #FDECEC;
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.page {
  padding: 20rpx 28rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background: var(--card);
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 10rpx 34rpx rgba(150, 116, 96, 0.07);
}

.card + .card {
  margin-top: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.card-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 90rpx 0 60rpx;
}

.empty-emoji {
  font-size: 68rpx;
  opacity: 0.85;
}

.empty-title {
  margin-top: 18rpx;
  font-size: 28rpx;
  color: var(--ink-2);
}

.empty-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}
