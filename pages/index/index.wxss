/* 情侣信息 */
.hero {
  position: relative;
  padding: 34rpx 32rpx 30rpx;
  border-radius: 32rpx;
  background: linear-gradient(140deg, #FFE9DF 0%, #FDE3EA 52%, #F3E8FA 100%);
  box-shadow: 0 14rpx 36rpx rgba(206, 158, 148, 0.16);
  overflow: hidden;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.couple {
  display: flex;
  align-items: center;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  box-shadow: 0 4rpx 14rpx rgba(180, 140, 130, 0.16);
}

.avatar.ta {
  background: rgba(255, 255, 255, 0.9);
}

.heart {
  margin: 0 10rpx;
  font-size: 26rpx;
  color: #E0868F;
}

.day-badge {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  color: #B4666F;
}

.day-label {
  font-size: 20rpx;
  opacity: 0.75;
}

.day-value {
  display: flex;
  align-items: baseline;
}

.day-num {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.day-unit {
  margin-left: 6rpx;
  font-size: 22rpx;
  opacity: 0.75;
}

.hero-names {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #4A3B33;
  letter-spacing: 1rpx;
}

.hero-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #9C7F78;
}

/* 分段视图 */
.view-switch {
  display: flex;
  margin-top: 24rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(150, 116, 96, 0.08);
}

.switch-item {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 27rpx;
  color: #8B7F74;
}

.switch-item.on {
  background: linear-gradient(135deg, #F4AEAE 0%, #E0868F 100%);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(224, 134, 143, 0.28);
}

.tab-panel {
  margin-top: 20rpx;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 56rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F4AEAE 0%, #E0868F 100%);
  color: #FFFFFF;
  font-size: 54rpx;
  font-weight: 300;
  line-height: 96rpx;
  text-align: center;
  box-shadow: 0 16rpx 32rpx rgba(224, 134, 143, 0.4);
  z-index: 90;
}

.fab-hover {
  transform: scale(0.94);
  opacity: 0.92;
}
