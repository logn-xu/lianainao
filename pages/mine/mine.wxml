<view class="page">
  <view class="card">
    <view class="card-title">我们俩</view>
    <view class="card-sub">昵称和头像会出现在每一条记录上</view>

    <view class="person">
      <view class="p-avatar me">{{profile.me.emoji}}</view>
      <view class="p-info">
        <input
          class="p-name"
          value="{{profile.me.name}}"
          data-role="me"
          bindblur="onNameBlur"
          maxlength="6"
          placeholder="我的昵称"
          placeholder-class="p-ph"
        />
        <text class="p-tip">我</text>
      </view>
    </view>
    <view class="avatars">
      <view
        class="av {{profile.me.emoji === item ? 'on' : ''}}"
        wx:for="{{avatars}}"
        wx:key="*this"
        data-role="me"
        data-emoji="{{item}}"
        bindtap="onPickAvatar"
      >{{item}}</view>
    </view>

    <view class="h-line"></view>

    <view class="person">
      <view class="p-avatar ta">{{profile.ta.emoji}}</view>
      <view class="p-info">
        <input
          class="p-name"
          value="{{profile.ta.name}}"
          data-role="ta"
          bindblur="onNameBlur"
          maxlength="6"
          placeholder="TA 的昵称"
          placeholder-class="p-ph"
        />
        <text class="p-tip">TA</text>
      </view>
    </view>
    <view class="avatars">
      <view
        class="av {{profile.ta.emoji === item ? 'on' : ''}}"
        wx:for="{{avatars}}"
        wx:key="*this"
        data-role="ta"
        data-emoji="{{item}}"
        bindtap="onPickAvatar"
      >{{item}}</view>
    </view>
  </view>

  <view class="card">
    <view class="sync-head">
      <view class="sync-title-wrap">
        <view class="card-title">双人同步</view>
        <view class="card-sub">{{bound ? (memberCount === 2 ? '已和 ' + profile.ta.name + ' 连上云端' : '把邀请码发给 TA，等 TA 加入') : '让两部手机看到同一份记录'}}</view>
      </view>
      <view class="sync-state {{bound && memberCount === 2 ? 'on' : ''}}">
        <view class="dot"></view>
        <text>{{bound ? (memberCount === 2 ? '已连接' : '待加入') : '未开启'}}</text>
      </view>
    </view>

    <block wx:if="{{bound}}">
      <view class="invite">
        <text class="invite-label">邀请码</text>
        <text class="invite-code" user-select="{{true}}">{{inviteCode}}</text>
        <view class="invite-copy" hover-class="row-hover" bindtap="onCopyInvite">复制</view>
      </view>

      <view class="members">
        <view class="member-chip">
          <text class="member-emoji">{{profile.me.emoji}}</text>
          <text class="member-name">{{profile.me.name}}</text>
        </view>
        <view class="member-link {{memberCount === 2 ? 'on' : ''}}">· · ·</view>
        <view class="member-chip {{memberCount === 2 ? '' : 'waiting'}}">
          <text class="member-emoji">{{memberCount === 2 ? profile.ta.emoji : '？'}}</text>
          <text class="member-name">{{memberCount === 2 ? profile.ta.name : '等 TA 加入'}}</text>
        </view>
      </view>

      <view class="row" hover-class="row-hover" bindtap="onSyncNow">
        <text class="row-label">立即同步</text>
        <text class="row-value">{{working ? '同步中…' : syncedText}}</text>
      </view>
      <view class="row" hover-class="row-hover" bindtap="onUnbind">
        <text class="row-label danger">解除绑定</text>
        <text class="chevron">›</text>
      </view>
    </block>

    <block wx:elif="{{cloudAvailable}}">
      <view class="sync-actions">
        <view class="btn primary" hover-class="btn-hover" bindtap="onCreateCouple">创建情侣空间</view>
        <view class="btn ghost" hover-class="btn-hover" bindtap="onJoinCouple">输入邀请码加入</view>
      </view>
      <view class="row-note">创建后把邀请码发给 TA，TA 输入后两边的记录就互通了。</view>
    </block>

    <view class="row-note" wx:else>当前微信版本不支持云开发，记录仍会安全地保存在本机。</view>
  </view>

  <view class="card">
    <view class="card-title">我们的日子</view>
    <view class="row">
      <text class="row-label">在一起的日子</text>
      <picker mode="date" value="{{profile.startDate}}" end="{{today}}" bindchange="onStartDateChange">
        <view class="row-value">
          <text>{{startDateText}}</text>
          <text class="chevron">›</text>
        </view>
      </picker>
    </view>
    <view class="row">
      <text class="row-label">平均周期</text>
      <picker mode="selector" range="{{cycles}}" value="{{cycleIndex}}" bindchange="onCycleChange">
        <view class="row-value">
          <text>{{cycles[cycleIndex]}}</text>
          <text class="chevron">›</text>
        </view>
      </picker>
    </view>
    <view class="row-note">周期用来预测下次姨妈，填平时的平均值就好。</view>
  </view>

  <view class="card">
    <view class="card-title">数据</view>
    <view class="row">
      <text class="row-label">记录总数</text>
      <text class="row-value plain">{{recordCount}} 条</text>
    </view>
    <view class="row" hover-class="row-hover" bindtap="onCopyData">
      <text class="row-label">复制数据备份</text>
      <text class="chevron">›</text>
    </view>
    <view class="row" wx:if="{{showClearRecords}}" hover-class="row-hover" bindtap="onClearRecords">
      <text class="row-label danger">清空所有记录</text>
      <text class="chevron">›</text>
    </view>
  </view>

  <view class="foot">
    记录保存在这台手机的微信里。想让两部手机实时看到同一份记录，可以后续接上微信云开发。
  </view>
</view>
